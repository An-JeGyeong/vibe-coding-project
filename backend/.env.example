# LOCAL DEVELOPMENT ONLY. Spring does NOT automatically load this file.
DB_URL=jdbc:mysql://localhost:3306/mangabridge
DB_USERNAME=mangabridge
DB_PASSWORD=mangabridge_local_only
CORS_ALLOWED_ORIGINS=http://localhost:3000
SPRING_PROFILES_ACTIVE=local
PORT=8080
AUTH_TOKEN_TTL_SECONDS=3600
DEMO_AUTH_SEED_ENABLED=false
# Supply DEMO_OPERATOR_PASSWORD / DEMO_TRANSLATOR_PASSWORD /
# DEMO_REVIEWER_PASSWORD / DEMO_READER_PASSWORD privately for one-off seed only.
# Optional Docker Compose variables; Compose reads the ROOT .env separately.
MYSQL_DATABASE=mangabridge
MYSQL_USER=mangabridge
MYSQL_PASSWORD=mangabridge_local_only
